# HTTPS — reverse proxy vers la console KODIVA (alias Docker kodiva-web).
# Généré sur le VPS : scripts/certbot-kodiva-web.sh
# Ne pas committer le fichier rendu (certificats Let’s Encrypt requis).

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${KODIVA_WEB_HOST};

  ssl_certificate /etc/letsencrypt/live/${KODIVA_WEB_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${KODIVA_WEB_HOST}/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  client_max_body_size 10M;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  resolver 127.0.0.11 valid=30s ipv6=off;

  location / {
    set $upstream_kodiva_web kodiva-web;
    proxy_pass http://$upstream_kodiva_web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
  }
}

# Ancien hôte : rediriger vers kodiva.sdcreativ.com (certificat ai déjà émis).
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${KODIVA_WEB_LEGACY_HOST};

  ssl_certificate /etc/letsencrypt/live/${KODIVA_WEB_LEGACY_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${KODIVA_WEB_LEGACY_HOST}/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  return 301 https://${KODIVA_WEB_HOST}$request_uri;
}
